# ── GMI Cloud (via Genblaze) ──────────────────────────────────────────────────
# Image generation — GMI Cloud Seedream / FLUX models (see console.gmicloud.ai for full list)
# Get your API key at: https://console.gmicloud.ai
GMI_API_KEY=gmi-...
GMI_IMAGE_MODEL=seedream-4-0-250828

# ── NVIDIA NIM ────────────────────────────────────────────────────────────────
# Narrative script generation (LLM). Set to use NIM instead of OpenAI fallback.
# Get your API key at: https://build.nvidia.com
NVIDIA_NIM_API_KEY=nvapi-...
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# ── Backblaze B2 ──────────────────────────────────────────────────────────────
# Copy the exact endpoint URL from your bucket details page in the B2 console.
B2_KEY_ID=...
B2_APPLICATION_KEY=...
B2_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
B2_BUCKET_NAME=bankers-wrapped-assets

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Used for: NarrativeAgent LLM fallback (when NIM key not set) + TTS narration audio
OPENAI_API_KEY=sk-...

# ── Plaid (optional — WS-4 "connect a bank" sandbox path) ────────────────────
# Sandbox only; free. Get keys at https://dashboard.plaid.com → Team Settings → Keys.
# Leave blank to disable the Plaid path entirely (CSV upload remains the default).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=False
PIPELINE_VERSION=1.0.0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your frontend origin in production.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
